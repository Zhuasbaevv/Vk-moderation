# Токен сообщества (Настройки сообщества -> Работа с API -> Ключи доступа)
VK_TOKEN=your_group_token_here

# ID сообщества (без минуса), например для vk.com/club123456 -> 123456
VK_GROUP_ID=123456

# ID пользователя(-ей) VK, который(-ые) будет(-ут) иметь роль "Создатель" при первом запуске.
# Можно указать несколько через запятую.
CREATOR_IDS=12345678

# Путь к файлу базы данных SQLite
DB_PATH=bot_data.db

# --- Мост с сайтом br-senior-bot (необязательно - без этого бот работает как раньше) ---
# Адрес веб-панели br-senior-bot, без слэша на конце
SITE_API_URL=https://your-site.up.railway.app
# ОДИНАКОВОЕ значение должно быть прописано и здесь, и в переменных br-senior-bot
SITE_BRIDGE_SECRET=придумайте_длинную_случайную_строку
# Порт для приёма объявлений с сайта (Railway/Render подставляют PORT сами)
BRIDGE_PORT=8081
